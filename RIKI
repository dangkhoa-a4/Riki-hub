-- Tween Function
local function TweenTo(pos)

	local char = plr.Character or plr.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart")

	local points = {
		Vector3.new(hrp.Position.X,50,hrp.Position.Z),
		Vector3.new(pos.X,50,pos.Z),
		pos + Vector3.new(0,5,0)
	}

	for _,point in ipairs(points) do

		local distance = (hrp.Position - point).Magnitude

		local tween = TweenService:Create(
			hrp,
			TweenInfo.new(distance / TweenSpeed, Enum.EasingStyle.Linear),
			{
				CFrame = CFrame.new(point)
			}
		)

		pcall(function()
			tween:Play()
			tween.Completed:Wait()
		end)
	end
end

-- Auto Chest
task.spawn(function()

	while task.wait(0.3) do

		if getgenv().AutoChest then

			local char = plr.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")

			if hrp then

				local nearest
				local distance = math.huge

				for _,v in pairs(CollectionService:GetTagged("_ChestTagged")) do

					if v
					and v.Parent
					and not v:GetAttribute("IsDisabled") then

						local mag = (hrp.Position - v:GetPivot().Position).Magnitude

						if mag < distance then
							distance = mag
							nearest = v
						end
					end
				end

				if nearest and distance < MaxDistance then

					status.Text = "Collecting Chest..."

					-- Anti Ban Delay
					task.wait(
						math.random(
							AntiBanDelayMin,
							AntiBanDelayMax
						)/100
					)

					TweenTo(nearest:GetPivot().Position)

					-- Anti Stuck
					if hrp.Velocity.Magnitude < 1 then
						hrp.CFrame = hrp.CFrame + Vector3.new(0,3,0)
					end

				else

					status.Text = "No Chest Found"
				end
			end

		else

			status.Text = "Auto Chest Disabled"
		end
	end
end)
